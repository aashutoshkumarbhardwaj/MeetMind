# Core security. Leave API_TOKEN empty only for local development.
APP_ENV=development
API_TOKEN=
# Comma-separated extra browser origins for a separately hosted web dashboard.
CORS_ORIGINS=

# AI_PROVIDER=groq uses hosted GPT-OSS. AI_PROVIDER=ollama uses local/self-hosted Ollama.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b

# TRANSCRIPTION_PROVIDER=groq sends audio to Groq. TRANSCRIPTION_PROVIDER=local uses faster-whisper.
TRANSCRIPTION_PROVIDER=groq
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Rate limits (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60
TRANSCRIPTION_RATE_LIMIT_PER_MINUTE=15
ANALYSIS_RATE_LIMIT_PER_MINUTE=20

# Timeouts in seconds for upstream provider requests
ANALYSIS_TIMEOUT_SECONDS=120
TRANSCRIPTION_TIMEOUT_SECONDS=180

BACKBOARD_API_KEY=

PAPERINSTRUMENTS_API_KEY=